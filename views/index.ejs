<%- include('partials/header') %>

<%
    const json = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
    const role = data.currentRole;
%>

<!-- Print-only CV header (the 3D hero is screen-only) -->
<header class="print-head">
    <h1><%= data.fullName %></h1>
    <p><%= role.title %>, <%= role.org %>. <%= data.title %>.</p>
    <p><%= data.location %>, <%= data.country %> | <%= data.phoneDisplay %> | github.com/<%= data.githubUsername %> | pandadevelopment.net</p>
</header>

<!-- ============ HERO: the badge ============ -->
<section class="hero" id="top" aria-labelledby="heroName">
    <canvas class="hero-canvas" id="badgeCanvas" aria-hidden="true"></canvas>

    <div class="hero-inner">
        <h1 class="hero-name" id="heroName">
            <span><%= data.firstName %></span>
            <span><%= data.lastName %></span>
        </h1>

        <div class="badge-slot" id="badgeSlot">
            <!-- Shown until (or unless) the 3D badge is ready -->
            <div class="badge-fallback" aria-hidden="true">
                <div class="badge-fallback-band"><span>Skie</span></div>
                <img src="<%= data.badgePhoto %>" alt="" width="880" height="700">
                <p class="badge-fallback-name"><%= data.lastName %></p>
                <p class="badge-fallback-role"><%= role.title %></p>
                <p class="badge-fallback-org"><%= role.org %></p>
            </div>
            <p class="hero-hint">Drag the badge. Flick it to see the back.</p>
        </div>

        <div class="hero-meta">
            <p class="hero-role"><strong><%= role.title %></strong> at <%= role.org %>. Software developer and systems integrator.</p>
            <p class="hero-place"><i class="fas fa-location-dot" aria-hidden="true"></i> <%= data.location %></p>
            <div class="hero-actions">
                <a class="btn btn-ink" href="#experience">Read the CV</a>
                <a class="btn btn-line" href="#contact">Get in touch</a>
            </div>
        </div>
    </div>
</section>

<!-- ============ NOW ============ -->
<section class="section now" id="now" aria-labelledby="nowTitle">
    <div class="container now-grid">
        <div class="now-text">
            <h2 class="section-title" id="nowTitle">Now teaching IT in Lapu-Lapu City.</h2>
            <% data.about.forEach(paragraph => { %>
                <p><%= paragraph %></p>
            <% }); %>
        </div>

        <dl class="facts">
            <div><dt>Role</dt><dd><%= role.title %>, <%= role.org %></dd></div>
            <div><dt>Based in</dt><dd><%= data.location %>, <%= data.country %></dd></div>
            <div><dt>Education</dt><dd>BS Information Technology, <%= data.college %>, class of 2026</dd></div>
            <div><dt>Experience</dt><dd>7+ years writing production code</dd></div>
            <div><dt>Age</dt><dd><%= data.age %></dd></div>
            <div><dt>Known as</dt><dd><%= data.nickname %></dd></div>
        </dl>
    </div>
</section>

<!-- ============ EXPERIENCE: the CV sheet ============ -->
<section class="section experience" id="experience" aria-labelledby="experienceTitle">
    <div class="container">
        <h2 class="section-title" id="experienceTitle">Experience</h2>

        <div class="sheet-stage">
            <article class="sheet">
                <header class="sheet-head">
                    <div>
                        <p class="sheet-name"><%= data.fullName %></p>
                        <p class="sheet-title"><%= role.title %>, <%= data.title %></p>
                    </div>
                    <ul class="sheet-contact">
                        <li><%= data.location %></li>
                        <li>github.com/<%= data.githubUsername %></li>
                        <li><%= data.phoneDisplay %></li>
                    </ul>
                </header>

                <ol class="timeline">
                    <% data.experience.forEach(job => { %>
                        <li class="job<%= job.current ? ' is-current' : '' %>">
                            <p class="job-period"><%= job.period %></p>
                            <div class="job-body">
                                <h3><%= job.title %><% if (job.current) { %> <span class="job-now">Current role</span><% } %></h3>
                                <p class="job-org"><%= job.org %><% if (job.location) { %>, <%= job.location %><% } %></p>
                                <p class="job-desc"><%= job.description %></p>
                            </div>
                        </li>
                    <% }); %>
                </ol>

                <div class="sheet-edu">
                    <h3 class="sheet-label">Education</h3>
                    <div class="job">
                        <p class="job-period"><%= data.schoolYear %></p>
                        <div class="job-body">
                            <h3><%= data.degree %></h3>
                            <p class="job-org"><%= data.college %></p>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>

<!-- ============ WORK ============ -->
<section class="section work" id="work" aria-labelledby="workTitle">
    <div class="container">
        <div class="section-head-row">
            <h2 class="section-title" id="workTitle">Selected work</h2>
            <a class="text-link" href="<%= data.github %>" target="_blank" rel="noopener"><i class="fab fa-github" aria-hidden="true"></i> More on GitHub</a>
        </div>

        <div class="work-grid">
            <% data.projects.forEach(project => { %>
                <article class="project" data-tilt="7">
                    <div class="project-inner">
                        <p class="project-role"><%= project.role %></p>
                        <h3 class="project-name"><%= project.name %></h3>
                        <p class="project-desc"><%= project.description %></p>
                        <ul class="project-tech">
                            <% project.tech.forEach(tech => { %><li><%= tech %></li><% }); %>
                        </ul>
                        <a class="project-link" href="<%= project.url %>" target="_blank" rel="noopener"><%= project.linkLabel %> <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
                    </div>
                </article>
            <% }); %>
        </div>
    </div>
</section>

<!-- ============ STACK: isometric layers ============ -->
<section class="section stack" id="stack" aria-labelledby="stackTitle">
    <div class="container">
        <div class="stack-head">
            <h2 class="section-title" id="stackTitle">From embedded hardware to AI tooling</h2>
            <p class="stack-lede">My work runs from the web down to embedded hardware. These are the layers I build in, and the tools I use at each one.</p>
        </div>

        <div class="stack-grid">
            <div class="tower" aria-hidden="true">
                <div class="tower-iso">
                    <% data.stack.slice().reverse().forEach((layer, i) => { %>
                        <div class="slab" style="--i: <%= i %>" data-layer="<%= data.stack.length - 1 - i %>">
                            <span class="slab-side slab-side-l"></span>
                            <span class="slab-side slab-side-r"></span>
                            <span class="slab-label"><%= layer.label %></span>
                        </div>
                    <% }); %>
                </div>
            </div>

            <ul class="layers">
                <% data.stack.forEach((layer, i) => { %>
                    <li class="layer" data-layer="<%= i %>">
                        <h3><%= layer.name %></h3>
                        <p><%= layer.items.join(', ') %></p>
                    </li>
                <% }); %>
            </ul>
        </div>
    </div>
</section>

<!-- ============ CREDENTIALS: cover-flow shelf ============ -->
<section class="section credentials" id="credentials" aria-labelledby="credentialsTitle">
    <div class="container">
        <div class="section-head-row">
            <h2 class="section-title" id="credentialsTitle">Certificates and awards</h2>
            <div class="shelf-controls">
                <button type="button" class="round-btn" data-shelf="-1" aria-label="Previous certificate"><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
                <button type="button" class="round-btn" data-shelf="1" aria-label="Next certificate"><i class="fas fa-arrow-right" aria-hidden="true"></i></button>
            </div>
        </div>
    </div>

    <div class="shelf" id="shelf">
        <ul class="shelf-track">
            <% data.certificates.forEach((cert, i) => { %>
                <li class="shelf-item<%= cert.category === 'Award' ? ' is-award' : '' %>">
                    <button type="button" class="cert" data-cert="<%= i %>" aria-label="View <%= cert.title %> certificate">
                        <span class="cert-frame"><img src="<%= cert.thumb %>" alt="" loading="lazy" decoding="async"></span>
                    </button>
                    <div class="cert-caption">
                        <p class="cert-kind"><%= cert.category %></p>
                        <h3><%= cert.title %></h3>
                        <p><%= cert.issuer %></p>
                        <p class="cert-date"><%= cert.date %></p>
                    </div>
                </li>
            <% }); %>
        </ul>
    </div>
</section>

<dialog class="lightbox" id="lightbox" aria-labelledby="lbTitle">
    <figure class="lb-figure">
        <img id="lbImg" src="" alt="">
        <figcaption>
            <h3 id="lbTitle"></h3>
            <p id="lbMeta"></p>
            <p id="lbDetails" class="lb-details"></p>
            <a id="lbOriginal" href="#" target="_blank" rel="noopener">Open the original scan</a>
        </figcaption>
    </figure>
    <button type="button" class="lb-btn lb-prev" data-lb="-1" aria-label="Previous certificate"><i class="fas fa-arrow-left" aria-hidden="true"></i></button>
    <button type="button" class="lb-btn lb-next" data-lb="1" aria-label="Next certificate"><i class="fas fa-arrow-right" aria-hidden="true"></i></button>
    <button type="button" class="lb-close" data-lb-close aria-label="Close"><i class="fas fa-xmark" aria-hidden="true"></i></button>
</dialog>

<!-- ============ CONTACT ============ -->
<section class="section contact" id="contact" aria-labelledby="contactTitle">
    <div class="container contact-grid">
        <div class="contact-copy">
            <h2 class="section-title" id="contactTitle">Let's talk</h2>
            <p>For freelance projects, collaborations, or teaching, send a message here or reach me directly.</p>
            <ul class="contact-list">
                <li><i class="fas fa-phone" aria-hidden="true"></i><a href="tel:<%= data.phone.replace(/-/g, '') %>"><%= data.phoneDisplay %></a></li>
                <li><i class="fab fa-github" aria-hidden="true"></i><a href="<%= data.github %>" target="_blank" rel="noopener">github.com/<%= data.githubUsername %></a></li>
                <li><i class="fas fa-globe" aria-hidden="true"></i><a href="<%= data.website %>" target="_blank" rel="noopener">pandadevelopment.net</a></li>
                <li><i class="fas fa-location-dot" aria-hidden="true"></i><span><%= data.location %>, <%= data.country %></span></li>
            </ul>
            <div class="socials">
                <a href="<%= data.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook-f" aria-hidden="true"></i></a>
                <a href="<%= data.youtube %>" target="_blank" rel="noopener" aria-label="YouTube"><i class="fab fa-youtube" aria-hidden="true"></i></a>
                <a href="<%= data.github %>" target="_blank" rel="noopener" aria-label="GitHub"><i class="fab fa-github" aria-hidden="true"></i></a>
            </div>
        </div>

        <form class="contact-form" id="contactForm" novalidate>
            <div class="field">
                <label for="name">Your name</label>
                <input type="text" id="name" name="name" autocomplete="name" required>
            </div>
            <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" autocomplete="email" required>
            </div>
            <div class="field">
                <label for="subject">Subject</label>
                <input type="text" id="subject" name="subject" required>
            </div>
            <div class="field">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="5" required></textarea>
            </div>
            <button type="submit" class="btn btn-ink">Send message</button>
            <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
        </form>
    </div>
</section>

<script type="application/json" id="certData"><%- json(data.certificates.map(c => ({ title: c.title, issuer: c.issuer, date: c.date, details: c.details, category: c.category, full: c.full, image: c.image }))) %></script>
<script type="application/json" id="badgeData"><%- json({
    photo: data.badgePhoto,
    firstNames: 'Kerneil Rommel S.',
    lastName: data.lastName,
    role: role.title,
    org: role.org,
    location: data.location,
    githubUrl: 'github.com/' + data.githubUsername,
    website: 'pandadevelopment.net',
    phone: data.phoneDisplay,
    stack: ['C# / .NET', 'Node.js & Express', 'Python & Django', 'React', 'Linux administration', 'Claude Code & MCP']
}) %></script>
<script type="importmap">
    {
        "imports": {
            "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js",
            "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/"
        }
    }
</script>
<script type="module" src="/js/badge.js"></script>

<%- include('partials/footer') %>
